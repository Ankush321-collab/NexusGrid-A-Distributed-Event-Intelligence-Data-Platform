# ==============================================================================
# NEXUSGRID PLATFORM - CENTRAL ENVIRONMENT CONFIGURATION (.env.example)
# 12-Factor Compliant Configuration for Distributed Event Intelligence
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & GLOBAL SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. MICROSERVICE PORTS
# ------------------------------------------------------------------------------
PORT_INGESTION=8080
PORT_AUTH=8081
PORT_EVENT_PROCESSOR=8082
PORT_QUERY=8083
PORT_ALERT=8084
PORT_OUTBOX_PUBLISHER=8085

# ------------------------------------------------------------------------------
# 3. POSTGRESQL METADATA STORAGE
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexusgrid
POSTGRES_USER=nexusgrid
POSTGRES_PASSWORD=nexusgrid_secure_pwd
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 4. REDIS (COORDINATION, RATE LIMITING & IDEMPOTENCY)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=ng:
RATE_LIMIT_MAX_TOKENS=100
RATE_LIMIT_REFILL_RATE=10
IDEMPOTENCY_TTL_SEC=86400

# ------------------------------------------------------------------------------
# 5. APACHE KAFKA (EVENT BUS - KRAFT MODE)
# ------------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nexusgrid-client
KAFKA_CONSUMER_GROUP=nexusgrid-workers-v1
KAFKA_RAW_TOPIC=nexusgrid.events.raw
KAFKA_DLQ_TOPIC=nexusgrid.events.dlq
KAFKA_RETRY_10S_TOPIC=nexusgrid.events.retry.10s
KAFKA_RETRY_1M_TOPIC=nexusgrid.events.retry.1m
KAFKA_RETRY_5M_TOPIC=nexusgrid.events.retry.5m
KAFKA_MAX_RETRIES=5

# ------------------------------------------------------------------------------
# 6. CLICKHOUSE (ANALYTICAL COLUMNAR ENGINE)
# ------------------------------------------------------------------------------
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=nexusgrid
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ------------------------------------------------------------------------------
# 7. MINIO / S3 (COLD EVENT ARCHIVAL)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secure_pwd
MINIO_BUCKET=nexusgrid-archives
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# 8. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
API_KEY_SALT=nexusgrid_static_salt_v1
API_KEY_SALT_ROUNDS=12
WEBHOOK_SIGNING_SECRET=nexusgrid_webhook_secret_key_v1

# ------------------------------------------------------------------------------
# 9. TUNING, BUFFER & RETENTION LIMITS
# ------------------------------------------------------------------------------
MAX_PAYLOAD_BYTES=1048576
MAX_BATCH_EVENTS=500
BATCH_SIZE_ITEMS=5000
BATCH_TIMEOUT_MS=500
QUERY_MAX_SCAN_DAYS=90
QUERY_TIMEOUT_MS=10000
CACHE_TTL_SEC=60
ALERT_EVAL_INTERVAL_MS=10000
ALERT_WEBHOOK_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
